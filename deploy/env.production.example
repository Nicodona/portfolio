# Copy to /opt/portfolio/.env on the droplet and fill in real values.

SECRET_KEY=CHANGE_ME_generate_a_long_random_string
DEBUG=False
ALLOWED_HOSTS=nico.martac.org,portfolio-web,localhost
CSRF_TRUSTED_ORIGINS=https://nico.martac.org
TIME_ZONE=Africa/Douala

# Which existing docker network the shared Caddy lives on (docker network ls)
CADDY_NETWORK=lewa_default

# n8n webhooks. Create the workflows in your n8n, paste the production
# webhook URLs here, then docker compose up -d again.
N8N_CONTACT_WEBHOOK=
N8N_VISIT_WEBHOOK=

GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120
